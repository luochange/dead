<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Nightwatch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Til" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/muted_dim</item>
        <item name="android:textColor">@color/text</item>
        <item name="boxBackgroundColor">@color/input_bg</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/muted_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="RowLabel">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="RowValue">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">end</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
